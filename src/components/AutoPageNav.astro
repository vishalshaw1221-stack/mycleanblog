---
// src/components/AutoPageNav.astro
// SIMPLE NAV: just renders prev / next passed as props

const { prev = null, next = null } = Astro.props;
---

<style>
  .auto-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #e5e7eb;
  }

  .auto-nav a {
    padding: 12px 16px;
    text-decoration: none;
    border-radius: 8px;
    background: #0ea5e9;
    color: white;
    font-size: 0.95rem;
    transition: background 0.2s;
    max-width: 220px;
  }

  .auto-nav a:hover {
    background: #0284c7;
  }

  .auto-nav .prev {
    text-align: left;
  }

  .auto-nav .next {
    text-align: right;
  }

  .auto-nav .disabled {
    visibility: hidden;
    width: 160px;
  }

  .auto-nav .page-title {
    display: block;
    font-weight: 600;
    font-size: 1rem;
  }

  .auto-nav .nav-label {
    font-size: 0.8rem;
    opacity: 0.9;
    display: block;
    margin-top: 2px;
  }
</style>

<div class="auto-nav" role="navigation" aria-label="Page navigation">
  {prev ? (
    <a href={`/blog/${prev.slug}/`} class="prev" title={prev.data.title}>
      <span class="nav-label">← Previous</span>
      <span class="page-title">{prev.data.title}</span>
    </a>
  ) : (
    <div class="disabled"></div>
  )}

  {next ? (
    <a href={`/blog/${next.slug}/`} class="next" title={next.data.title}>
      <span class="nav-label">Next →</span>
      <span class="page-title">{next.data.title}</span>
    </a>
  ) : (
    <div class="disabled"></div>
  )}
</div>