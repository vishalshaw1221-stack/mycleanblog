---
// src/components/AutoPageNav.astro
// SMART navigation - works within each folder automatically

const { current = null } = Astro.props;

// Normalize: add trailing slash and lowercase (to match Astro slugs)
const normalize = (p) => {
  if (!p) return '/';
  const withSlash = p.endsWith('/') ? p : p + '/';
  return withSlash.toLowerCase();
};

// Current path: raw (for folder), normalized (for comparison)
const rawCurrentPath = current || Astro.url.pathname || '/';
const currentPath = normalize(rawCurrentPath);

// "/blog/second-post/how-its-going/" → "second-post"
const currentFolder = rawCurrentPath.split('/')[2];

// Only index.mdx (your original working pattern)
const allModules = import.meta.glob('/src/content/blog/**/index.mdx', {
  eager: true
});

const pages = Object.entries(allModules)
  .map(([filePath, module]) => {
    // "/src/content/blog/second-post/What-is-up/index.mdx"
    //   → "/blog/second-post/What-is-up/"
    let route = filePath
      .replace('/src/content/blog', '/blog')
      .replace('/index.mdx', '/');

    const normalizedRoute = normalize(route);

    // "/src/content/blog/second-post/What-is-up/index.mdx" → "second-post"
    const pathParts = filePath.split('/');
    const fileFolder = pathParts[4];

    return {
      // use LOWERCASED route everywhere
      route: normalizedRoute,
      title: module.frontmatter?.title || 'Untitled',
      order: module.frontmatter?.order ?? 999,
      folder: fileFolder
    };
  })
  .filter((page) => page.folder === currentFolder)
  .sort((a, b) => a.order - b.order);

// DEBUG
console.log('Navigation Debug:');
console.log('Raw current path:', rawCurrentPath);
console.log('Normalized current path:', currentPath);
console.log('Current folder:', currentFolder);
console.log(
  'Found pages:',
  pages.map((p) => ({
    route: p.route,
    folder: p.folder,
    order: p.order
  }))
);

const currentIndex = pages.findIndex(
  (page) => page.route === currentPath
);

const prevPage = currentIndex > 0 ? pages[currentIndex - 1] : null;
const nextPage =
  currentIndex >= 0 && currentIndex < pages.length - 1
    ? pages[currentIndex + 1]
    : null;
---

<style>
.auto-nav {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid #e5e7eb;
}

.auto-nav a {
  padding: 12px 16px;
  text-decoration: none;
  border-radius: 8px;
  background: #0ea5e9;
  color: white;
  font-size: 0.95rem;
  transition: background 0.2s;
  max-width: 200px;
}

.auto-nav a:hover {
  background: #0284c7;
}

.auto-nav .prev {
  text-align: left;
}

.auto-nav .next {
  text-align: right;
}

.auto-nav .disabled {
  visibility: hidden;
  width: 160px;
}

.auto-nav .page-title {
  display: block;
  font-weight: 600;
  font-size: 1rem;
}

.auto-nav .nav-label {
  font-size: 0.8rem;
  opacity: 0.9;
  display: block;
  margin-top: 2px;
}
</style>

<div class="auto-nav" role="navigation" aria-label="Page navigation">
  {prevPage ? (
    <a href={prevPage.route} class="prev" title={prevPage.title}>
      <span class="nav-label">← Previous</span>
      <span class="page-title">{prevPage.title}</span>
    </a>
  ) : (
    <div class="disabled"></div>
  )}

  {nextPage ? (
    <a href={nextPage.route} class="next" title={nextPage.title}>
      <span class="nav-label">Next →</span>
      <span class="page-title">{nextPage.title}</span>
    </a>
  ) : (
    <div class="disabled"></div>
  )}
</div>