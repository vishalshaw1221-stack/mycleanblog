---
// src/components/AutoPageNav.astro
// Auto previous/next navigation within each top-level blog folder

const { current = null } = Astro.props;

// Get current path from prop or URL
const currentPath = current || Astro.url.pathname || '';

// Normalize path to always have trailing slash
const normalize = (p) => {
  if (!p) return '';
  return p.endsWith('/') ? p : p + '/';
};

const normalizedCurrentPath = normalize(currentPath);

// Helper: extract folder name from a route (e.g. "/blog/statistics/descriptive/" → "statistics")
function getFolderFromRoute(route) {
  const parts = route.split('/').filter(Boolean); // remove empty segments
  const blogIndex = parts.indexOf('blog');
  if (blogIndex === -1) return null;
  return parts[blogIndex + 1] || null;
}

const currentFolder = getFolderFromRoute(normalizedCurrentPath);

// Load ALL .mdx posts under /src/content/blog
const allModules = import.meta.glob('/src/content/blog/**/*.mdx', {
  eager: true
});

// Build list of pages
const allPages = Object.entries(allModules).map(([filePath, module]) => {
  // Examples:
  // "/src/content/blog/statistics/descriptive/index.mdx"
  // "/src/content/blog/statistics/descriptive.mdx"

  // Build route used on site:
  //  "/src/content/blog" → "/blog"
  //  handle both "index.mdx" and normal ".mdx" files
  let route = filePath
    .replace('/src/content/blog', '/blog')
    .replace(/\/index\.mdx$/, '/')  // "....../something/index.mdx" → "....../something/"
    .replace(/\.mdx$/, '/');        // "....../something.mdx" → "....../something/"

  route = normalize(route);
  const folder = getFolderFromRoute(route);

  return {
    route,
    title: module.frontmatter?.title || 'Untitled',
    order: module.frontmatter?.order ?? 999,
    folder
  };
});

// Keep only pages from the current folder
const pages = allPages
  .filter((page) => page.folder === currentFolder)
  .sort((a, b) => a.order - b.order);

// DEBUG: you can comment these out later
console.log('Navigation Debug:');
console.log('Current path:', currentPath);
console.log('Normalized current path:', normalizedCurrentPath);
console.log('Current folder:', currentFolder);
console.log(
  'Found pages in folder:',
  pages.map((p) => ({ route: p.route, folder: p.folder, order: p.order }))
);

// Find current page index (ignore trailing slash differences just in case)
const currentIndex = pages.findIndex(
  (page) =>
    normalize(page.route) === normalizedCurrentPath ||
    page.route === currentPath
);

const prevPage = currentIndex > 0 ? pages[currentIndex - 1] : null;
const nextPage =
  currentIndex >= 0 && currentIndex < pages.length - 1
    ? pages[currentIndex + 1]
    : null;
---

<style>
  .auto-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #e5e7eb;
  }

  .auto-nav a {
    padding: 12px 16px;
    text-decoration: none;
    border-radius: 8px;
    background: #0ea5e9;
    color: white;
    font-size: 0.95rem;
    transition: background 0.2s;
    max-width: 200px;
  }

  .auto-nav a:hover {
    background: #0284c7;
  }

  .auto-nav .prev {
    text-align: left;
  }

  .auto-nav .next {
    text-align: right;
  }

  .auto-nav .disabled {
    visibility: hidden;
    width: 160px;
  }

  .auto-nav .page-title {
    display: block;
    font-weight: 600;
    font-size: 1rem;
  }

  .auto-nav .nav-label {
    font-size: 0.8rem;
    opacity: 0.9;
    display: block;
    margin-top: 2px;
  }
</style>

<div class="auto-nav" role="navigation" aria-label="Page navigation">
  {prevPage ? (
    <a href={prevPage.route} class="prev" title={prevPage.title}>
      <span class="nav-label">← Previous</span>
      <span class="page-title">{prevPage.title}</span>
    </a>
  ) : (
    <div class="disabled"></div>
  )}

  {nextPage ? (
    <a href={nextPage.route} class="next" title={nextPage.title}>
      <span class="nav-label">Next →</span>
      <span class="page-title">{nextPage.title}</span>
    </a>
  ) : (
    <div class="disabled"></div>
  )}
</div>