---
const { content } = Astro.props;
---

<div class="latex-container">
  <script src="https://cdn.jsdelivr.net/npm/latex.js@0.12.4/dist/latex.min.js"></script>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/latex.js@0.12.4/dist/latex.css">
  
  <div id="latex-{Math.random().toString(36).substr(2, 9)}">
    {content}
  </div>
  
  <script is:inline>
    // Wait for LaTeX.js to load
    function renderLaTeX() {
      if (typeof latexjs !== 'undefined') {
        const container = document.currentScript.previousElementSibling;
        try {
          container.innerHTML = latexjs.html(container.textContent);
        } catch (error) {
          container.innerHTML = '<div style="color: red;">LaTeX Error: ' + error.message + '</div>';
        }
      } else {
        // Retry after a short delay
        setTimeout(renderLaTeX, 100);
      }
    }
    
    // Start rendering
    renderLaTeX();
  </script>
</div>

<style>
  .latex-container {
    margin: 2rem 0;
    border: 1px solid #e5e5e5;
    border-radius: 8px;
    padding: 20px;
    background: white;
  }
</style>