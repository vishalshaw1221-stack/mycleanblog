  Full article reproduction is not allowed.
</div>

<style>
  /* 🔹 SOCIAL ICONS BOX */
  .social-footer {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 120px;
    text-align: center;
    color: white;
    font-family: 'Poppins', sans-serif;
    /* Box styling */
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(59, 130, 246, 0.2);
    border-radius: 12px;
    margin: 0;
    padding: 0;
    /* Ensure proper containment */
    overflow: hidden;
    position: relative;
  }

  /* Container to ensure perfect centering */
  .social-container {
    width: 100%;
    height: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
    box-sizing: border-box;
  }

  .social-media {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 25px;
    width: auto;
    margin: 0 auto;
    padding: 0;
    /* Center the entire icons group */
    justify-content: center;
  }

  .icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 75px;
    height: 75px;
    font-size: 38px;
    color: white;
    border-radius: 16px;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(59, 130, 246, 0.3);
    box-shadow: 0 0 15px rgba(59, 130, 246, 0.25);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    position: relative;
    flex-shrink: 0;
  }

  .icon-link::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 16px;
    padding: 1px;
    background: linear-gradient(135deg, #3b82f6, #9333ea, #ef4444);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    -webkit-mask-composite: destination-out;
    pointer-events: none;
  }

  .icon-link:hover {
    transform: scale(1.12);
    box-shadow: 0 0 25px rgba(147, 51, 234, 0.6);
  }

  .icon-link:hover i {
    color: #60a5fa;
  }

  /* 🔹 COPYRIGHT - COMPLETELY SEPARATE FROM FOOTER */
  .copyright {
    text-align: center;
    font-size: 0.82rem;
    color: #aaaaaa;
    font-family: 'Poppins', sans-serif;
    line-height: 1.5;
    width: 100%;
    margin: 15px 0 0 0;
    padding: 15px 10px;
  }

  /* 📱 MOBILE: FIXED ICON CONTAINMENT */
  @media (max-width: 768px) {
    .social-footer {
      min-height: 100px;
      padding: 0;
      margin: 0;
      /* Strong visual boundary */
      background: rgba(30, 41, 59, 0.3);
      border: 2px solid rgba(59, 130, 246, 0.3);
      border-radius: 12px;
      /* Force containment */
      overflow: visible;
    }

    .social-container {
      padding: 10px 15px;
      height: 100%;
      /* Ensure content stays within bounds */
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
    }

    .social-media {
      gap: 12px;
      padding: 5px;
      margin: 0 auto;
      /* Force horizontal centering */
      justify-content: center;
      align-items: center;
      width: fit-content;
      max-width: 100%;
    }

    .icon-link {
      width: 44px;
      height: 44px;
      font-size: 20px;
      border-radius: 10px;
      /* Ensure icons don't overflow */
      flex-shrink: 0;
    }

    /* Copyright completely outside */
    .copyright {
      font-size: 0.75rem;
      margin-top: 20px;
      padding: 12px 15px 5px;
      border-top: 1px solid rgba(255, 255, 255, 0.2);
      background: transparent;
    }
  }

  /* Small mobile devices */
  @media (max-width: 480px) {
    .social-footer {
      min-height: 90px;
      border-radius: 10px;
    }

    .social-container {
      padding: 8px 12px;
    }

    .social-media {
      gap: 10px;
    }

    .icon-link {
      width: 40px;
      height: 40px;
      font-size: 18px;
      border-radius: 8px;
    }

    .copyright {
      font-size: 0.7rem;
      margin-top: 15px;
      padding: 10px 12px 3px;
    }
  }

  /* Extra small screens - force single row */
  @media (max-width: 380px) {
    .social-footer {
      min-height: 80px;
    }

    .social-container {
      padding: 6px 10px;
    }

    .social-media {
      gap: 8px;
      flex-wrap: nowrap; /* Prevent wrapping to second row */
      overflow-x: auto;
      justify-content: center;
      width: 100%;
      padding: 2px;
    }

    .icon-link {
      width: 38px;
      height: 38px;
      font-size: 17px;
      border-radius: 8px;
      flex-shrink: 0;
    }

    .copyright {
      font-size: 0.65rem;
      margin-top: 12px;
    }
  }

  /* Very small screens */
  @media (max-width: 320px) {
    .social-media {
      gap: 6px;
    }

    .icon-link {
      width: 36px;
      height: 36px;
      font-size: 16px;
    }
  }
</style>