<style>
  /* 🔹 BOX THAT HOLDS THE ICONS ONLY */
  .social-footer {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 120px;
    text-align: center;
    color: white;
    font-family: 'Poppins', sans-serif;
    background: rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    margin: 0 auto;
    padding: 0;
    position: relative;
    border: 1px solid rgba(59, 130, 246, 0.15);
  }

  /* Container to ensure perfect centering */
  .social-container {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 20px;
  }

  /* ICONS ROW - Perfectly centered */
  .social-media {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 25px;
    max-width: 100%;
    margin: 0 auto;
    padding: 0;
  }

  .icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 75px;
    height: 75px;
    font-size: 38px;
    color: white;
    border-radius: 16px;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(59, 130, 246, 0.3);
    box-shadow: 0 0 15px rgba(59, 130, 246, 0.25);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    position: relative;
    flex-shrink: 0;
  }

  .icon-link::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 16px;
    padding: 1px;
    background: linear-gradient(135deg, #3b82f6, #9333ea, #ef4444);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    -webkit-mask-composite: destination-out;
    pointer-events: none;
  }

  .icon-link:hover {
    transform: scale(1.12);
    box-shadow: 0 0 25px rgba(147, 51, 234, 0.6);
  }

  .icon-link:hover i {
    color: #60a5fa;
  }

  /* 🔹 COPYRIGHT TEXT – COMPLETELY OUTSIDE THE BOX */
  .copyright {
    margin-top: 1.5rem;       /* Increased gap to clearly separate from box */
    margin-bottom: 1.2rem;
    text-align: center;
    font-size: 0.82rem;
    color: #aaaaaa;
    font-family: 'Poppins', sans-serif;
    line-height: 1.5;
    padding: 0 10px;
    width: 100%;
  }

  /* 📱 MOBILE TWEAKS - Ensuring perfect centering on mobile */
  @media (max-width: 768px) {
    .social-footer {
      min-height: 110px;
      padding: 0;
    }

    .social-container {
      padding: 15px;
    }

    .social-media {
      gap: 16px;
      padding: 0;
      width: 100%;
      justify-content: center;
    }

    .icon-link {
      width: 60px;
      height: 60px;
      font-size: 28px;
      border-radius: 12px;
    }

    .copyright {
      font-size: 0.78rem;
      margin-top: 1.2rem; /* Maintain clear separation on mobile */
      padding: 0 15px;
    }
  }

  @media (max-width: 480px) {
    .social-media {
      gap: 12px;
      justify-content: center;
    }

    .icon-link {
      width: 55px;
      height: 55px;
      font-size: 24px;
      border-radius: 10px;
    }

    .copyright {
      font-size: 0.75rem;
      margin-top: 1rem;
    }
  }

  /* Extra small devices */
  @media (max-width: 360px) {
    .social-media {
      gap: 10px;
    }

    .icon-link {
      width: 50px;
      height: 50px;
      font-size: 22px;
    }
  }
</style>