---
// src/components/AutoPageNav.astro

const { current = null } = Astro.props;

// 1) Get current path from prop or URL
const currentPath = current || Astro.url.pathname;

// Normalize: ensure trailing slash so it matches our generated routes
const normalizedCurrentPath = currentPath.endsWith('/')
  ? currentPath
  : currentPath + '/';

// Helper: extract folder name from a route like "/blog/statistics/introduction/"
function getFolderFromRoute(route: string) {
  const parts = route.split('/').filter(Boolean); 
  // examples:
  // "/blog/statistics/introduction/" -> ["blog","statistics","introduction"]
  // "/blog/nuclear-physics/"        -> ["blog","nuclear-physics"]
  // folder is always parts[1] (after "blog")
  return parts[1] || null;
}

const currentFolder = getFolderFromRoute(normalizedCurrentPath);

// 2) Load ALL .mdx posts under /src/content/blog
const allModules = import.meta.glob('/src/content/blog/**/*.mdx', {
  eager: true
});

// 3) Build page list (route, title, order, folder)
const pages = Object.entries(allModules)
  .map(([filePath, module]: any) => {
    // filePath examples:
    // "/src/content/blog/statistics/introduction/index.mdx"
    // "/src/content/blog/nuclear-physics/intro.mdx"

    // Build the public route:
    //  "/src/content/blog" -> "/blog"
    //  remove ".mdx" -> add trailing '/'
    let route = filePath
      .replace('/src/content/blog', '/blog')
      .replace(/\.mdx$/, '/');

    const folder = getFolderFromRoute(route);

    return {
      route,
      title: module.frontmatter?.title || 'Untitled',
      order: module.frontmatter?.order ?? 999,
      folder
    };
  })
  // Only keep pages from *this* folder
  .filter((page) => page.folder === currentFolder)
  // Sort within folder by "order"
  .sort((a, b) => a.order - b.order);

// DEBUG (optional – remove later)
console.log('Navigation Debug:');
console.log('Current path:', normalizedCurrentPath);
console.log('Current folder:', currentFolder);
console.log(
  'Found pages:',
  pages.map((p) => ({ route: p.route, folder: p.folder, order: p.order }))
);

// 4) Find current page in that folder
const currentIndex = pages.findIndex(
  (page) => page.route === normalizedCurrentPath
);

const prevPage = currentIndex > 0 ? pages[currentIndex - 1] : null;
const nextPage =
  currentIndex >= 0 && currentIndex < pages.length - 1
    ? pages[currentIndex + 1]
    : null;
---

<style>
  .auto-nav {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid #e5e7eb;
  }

  .auto-nav a {
    padding: 12px 16px;
    text-decoration: none;
    border-radius: 8px;
    background: #0ea5e9;
    color: white;
    font-size: 0.95rem;
    transition: background 0.2s;
    max-width: 200px;
  }

  .auto-nav a:hover {
    background: #0284c7;
  }

  .auto-nav .prev {
    text-align: left;
  }

  .auto-nav .next {
    text-align: right;
  }

  .auto-nav .disabled {
    visibility: hidden;
    width: 160px;
  }

  .auto-nav .page-title {
    display: block;
    font-weight: 600;
    font-size: 1rem;
  }

  .auto-nav .nav-label {
    font-size: 0.8rem;
    opacity: 0.9;
    display: block;
    margin-top: 2px;
  }
</style>

<div class="auto-nav" role="navigation" aria-label="Page navigation">
  {prevPage ? (
    <a href={prevPage.route} class="prev" title={prevPage.title}>
      <span class="nav-label">← Previous</span>
      <span class="page-title">{prevPage.title}</span>
    </a>
  ) : (
    <div class="disabled"></div>
  )}

  {nextPage ? (
    <a href={nextPage.route} class="next" title={nextPage.title}>
      <span class="nav-label">Next →</span>
      <span class="page-title">{nextPage.title}</span>
    </a>
  ) : (
    <div class="disabled"></div>
  )}
</div>