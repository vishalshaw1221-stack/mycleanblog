---
// src/components/AutoPageNav.astro

const { current = null } = Astro.props;

// Get all statistics posts with eager loading to access frontmatter
const modules = import.meta.glob('/src/content/blog/statistics/**/index.mdx', { 
  eager: true 
});

// Convert to array and extract needed data
const pages = Object.entries(modules).map(([filePath, module]) => {
  const route = filePath
    .replace('/src/content', '')
    .replace('/index.mdx', '');
    
  return {
    route: route,
    title: module.frontmatter?.title || 'Untitled',
    order: module.frontmatter?.order || 999,
    filePath: filePath
  };
});

// Sort pages by order frontmatter
pages.sort((a, b) => a.order - b.order);

// Find current page index
const currentPath = current || Astro.url.pathname;
const currentIndex = pages.findIndex(page => 
  page.route === currentPath.replace('/blog', '')
);

// Get previous and next pages
const prevPage = currentIndex > 0 ? pages[currentIndex - 1] : null;
const nextPage = currentIndex < pages.length - 1 ? pages[currentIndex + 1] : null;
---

<style>
.auto-nav {
  display: flex;
  justify-content: space-between;
  gap: 1rem;
  margin-top: 3rem;
  padding-top: 2rem;
  border-top: 1px solid #e5e7eb;
}

.auto-nav a {
  padding: 12px 16px;
  text-decoration: none;
  border-radius: 8px;
  background: #0ea5e9;
  color: white;
  font-size: 0.95rem;
  transition: background 0.2s;
  max-width: 200px;
}

.auto-nav a:hover {
  background: #0284c7;
}

.auto-nav .prev {
  text-align: left;
}

.auto-nav .next {
  text-align: right;
}

.auto-nav .disabled {
  visibility: hidden;
  width: 160px;
}

.auto-nav .page-title {
  display: block;
  font-weight: 600;
  font-size: 1rem;
}

.auto-nav .nav-label {
  font-size: 0.8rem;
  opacity: 0.9;
  display: block;
  margin-top: 2px;
}
</style>

<div class="auto-nav" role="navigation" aria-label="Page navigation">
  {prevPage ? (
    <a href={`/blog${prevPage.route}`} class="prev" title={prevPage.title}>
      <span class="nav-label">← Previous</span>
      <span class="page-title">{prevPage.title}</span>
    </a>
  ) : (
    <div class="disabled"></div>
  )}

  {nextPage ? (
    <a href={`/blog${nextPage.route}`} class="next" title={nextPage.title}>
      <span class="nav-label">Next →</span>
      <span class="page-title">{nextPage.title}</span>
    </a>
  ) : (
    <div class="disabled"></div>
  )}
</div>