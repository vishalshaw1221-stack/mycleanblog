---
/* No props needed for now */
---

<div class="latexjs-container">
  <slot />
</div>

<!-- Load LaTeX.js library from CDN (defines global `latexjs`) -->
<script
  src="https://cdn.jsdelivr.net/npm/latex.js@0.12.4/dist/latex.js"
  is:inline
></script>

<!-- Load the default LaTeX.js CSS so it looks like a PDF -->
<link
  rel="stylesheet"
  href="https://cdn.jsdelivr.net/npm/latex.js@0.12.4/dist/latex.css"
/>

<!-- Convert the LaTeX inside .latexjs-container to HTML -->
<script is:inline>
  document.addEventListener("DOMContentLoaded", () => {
    const containers = document.querySelectorAll(".latexjs-container");

    containers.forEach((el) => {
      const src = el.textContent; // raw LaTeX inside <LaTeXRenderer> ... </LaTeXRenderer>

      // Make sure latexjs is actually loaded
      if (typeof latexjs === "undefined") {
        console.error("LaTeX.js library not loaded (latexjs is undefined)");
        return;
      }

      const generator = new latexjs.HtmlGenerator({ hyphenate: false });

      latexjs.parse(src, { generator });

      const frag = generator.domFragment();

      // Replace the raw text with generated HTML
      el.innerHTML = "";
      el.appendChild(frag);
    });
  });
</script>