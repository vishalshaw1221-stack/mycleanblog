<style>
  /* 🔹 BOX THAT HOLDS THE ICONS ONLY */
  .social-footer {
    width: 100%;
    display: flex;
    justify-content: center;
    align-items: center;
    min-height: 120px;
    text-align: center;
    color: white;
    font-family: 'Poppins', sans-serif;
    padding: 20px 0;
  }

  /* ICONS ROW */
  .social-media {
    display: flex;
    justify-content: center;
    align-items: center;
    flex-wrap: wrap;
    gap: 25px;
    max-width: 100%;
    padding: 0 20px;
  }

  .icon-link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 75px;
    height: 75px;
    font-size: 38px;
    color: white;
    border-radius: 16px;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid rgba(59, 130, 246, 0.3);
    box-shadow: 0 0 15px rgba(59, 130, 246, 0.25);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
    position: relative;
    flex-shrink: 0;
  }

  .icon-link::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 16px;
    padding: 1px;
    background: linear-gradient(135deg, #3b82f6, #9333ea, #ef4444);
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    -webkit-mask-composite: destination-out;
    pointer-events: none;
  }

  .icon-link:hover {
    transform: scale(1.12);
    box-shadow: 0 0 25px rgba(147, 51, 234, 0.6);
  }

  .icon-link:hover i {
    color: #60a5fa;
  }

  /* 🔹 COPYRIGHT TEXT – OUTSIDE THE BOX, BELOW IT */
  .copyright {
    text-align: center;
    font-size: 0.82rem;
    color: #aaaaaa;
    font-family: 'Poppins', sans-serif;
    line-height: 1.5;
    padding: 0 10px;
  }

  /* 📱 MOBILE TWEAKS - Copyright completely outside footer box */
  @media (max-width: 768px) {
    .social-footer {
      min-height: 110px;
      padding: 25px 0; /* Padding only inside the footer box */
      margin-bottom: 0; /* No margin that could affect copyright position */
    }

    .social-media {
      gap: 16px;
      padding: 0 15px;
    }

    .icon-link {
      width: 60px;
      height: 60px;
      font-size: 28px;
      border-radius: 12px;
    }

    /* Copyright positioned completely outside the footer */
    .copyright {
      font-size: 0.78rem;
      margin-top: 10px; /* Space between footer box and copyright */
      padding: 15px 10px 0; /* Padding only on copyright, not connected to footer */
      border-top: 1px solid rgba(255, 255, 255, 0.1); /* Visual separation */
    }
  }

  @media (max-width: 480px) {
    .social-media {
      gap: 12px;
    }

    .icon-link {
      width: 55px;
      height: 55px;
      font-size: 24px;
      border-radius: 10px;
    }

    .copyright {
      font-size: 0.75rem;
      margin-top: 8px;
      padding: 12px 10px 0;
    }
  }
</style>